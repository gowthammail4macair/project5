{
  "name": "project5",
  "version": "1.0.0",
  "private": true,
  "description": "Project5 reference QA candidate using Gen1 pftest state; ownership stays with B",
  "scripts": {
    "test": "node --test test/*.test.cjs",
    "typecheck": "tsc --noEmit",
    "synth": "node --import tsx scripts/project5-synth.ts reference",
    "validate": "npm run typecheck && npm test && npm run synth",
    "frontend:build": "node scripts/build-frontend.cjs",
    "postinstall": "node scripts/patch-amplify-import.cjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@aws-sdk/client-apigatewaymanagementapi": "^3.0.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1000.0",
    "@aws-sdk/client-dynamodb": "^3.0.0",
    "@aws-sdk/lib-dynamodb": "^3.0.0",
    "aws-jwt-verify": "5.2.1"
  },
  "devDependencies": {
    "@aws-amplify/amplify-appsync-simulator": "2.16.20",
    "@aws-amplify/backend": "1.25.1",
    "@aws-amplify/backend-cli": "1.10.0",
    "@types/node": "^22.0.0",
    "amazon-cognito-identity-js": "6.3.16",
    "aws-cdk-lib": "2.272.0",
    "constructs": "10.8.1",
    "esbuild": "0.28.2",
    "graphql": "15.10.3",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  }
}
